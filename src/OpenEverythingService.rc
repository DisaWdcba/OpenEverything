#include "version.h"

1 VERSIONINFO
 FILEVERSION OE_VERSION_NUMERIC
 PRODUCTVERSION OE_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DisaWdcba\0"
            VALUE "FileDescription", "OpenEverything NTFS/USN Index Service\0"
            VALUE "FileVersion", OE_FILE_VERSION_STRING
            VALUE "InternalName", "OpenEverythingService\0"
            VALUE "OriginalFilename", "OpenEverythingService.exe\0"
            VALUE "ProductName", "OpenEverything\0"
            VALUE "ProductVersion", OE_PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

1 24 "OpenEverythingService.manifest"
