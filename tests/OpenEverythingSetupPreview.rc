#include "resource.h"
#include "version.h"

IDI_APP_ICON ICON "..\\res\\OpenEverything.ico"

1 24 "OpenEverythingSetupPreview.manifest"

1 VERSIONINFO
 FILEVERSION OE_VERSION_NUMERIC
 PRODUCTVERSION OE_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DisaWdcba\0"
            VALUE "FileDescription", "OpenEverything Setup UI Preview\0"
            VALUE "FileVersion", OE_FILE_VERSION_STRING
            VALUE "InternalName", "OpenEverythingSetupPreview\0"
            VALUE "OriginalFilename", "OpenEverythingSetupPreview.exe\0"
            VALUE "ProductName", "OpenEverything\0"
            VALUE "ProductVersion", OE_PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
